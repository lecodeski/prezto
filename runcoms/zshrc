  # and PATH_DIRS gives a slashed relative word a PATH search too
  builtin whence -- ${~_zah_w} > /dev/null && return 0

  # auto_cd oracle (cwd dirs, cdable_vars, hash -d, cdpath): the probe's status is the verdict
  ( builtin cd -q -- ${~_zah_w} ) &> /dev/null && return 0
