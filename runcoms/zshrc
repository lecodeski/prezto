_gen_completion() {  # $1 command, $@ its generator command line — each generator costs ~20ms per shell
  local cache=${XDG_CACHE_HOME:-$HOME/.cache}/prezto-generated-completions/_$1
  # unwritable cache: skip silently, keep generator errors visible
  [[ ! -s $cache || $cache -ot $commands[$1] ]] && { mkdir -p ${cache:h} 2> /dev/null && "$@" >| $cache }
  [[ -s $cache ]] && source $cache
}
(( $+commands[ipinfo] )) && _gen_completion ipinfo completion zsh
