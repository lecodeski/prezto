captioned-delimiter() {
  local termwidth="$(tput cols)"
  local padding="$(printf '%0.1s' $2{1..500})"
  printf '%*.*s %s %*.*s\n' 0 "$(((termwidth-2-${#1})/2))" "$padding" "$1" 0 "$(((termwidth-1-${#1})/2))" "$padding"
}

if (( $+commands[claude] )); then
