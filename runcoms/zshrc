    ci() { claude --print "$@" | glow --width 120 }
  else
    ci() { claude --print "$@" }
  fi
  cih() { ci --model=Haiku "$@" }
  cis() { ci --model=Sonnet "$@" }

  ca() {
    if [[ $1 == -- ]]; then
      claude attach "${@:2}"
    elif [[ $1 == [^-]* ]]; then
      claude attach "$@"
    else
      claude agents "$@"
    fi
  }

  # Runs `_claude` once per injected subcommand word, chosen per cursor slot;
  # only the still-open first arg needs both, whose matches then accumulate
  (( $+functions[_claude] )) && _ca() {
    local -a orig=("${words[@]}") rest=("${(@)words[2,-1]}") subs
    local cur=$CURRENT
    if (( CURRENT > 2 )) && [[ $rest[1] == -- ]]; then
      shift rest; (( cur-- )); subs=(attach)  # else _arguments eats it as the session id
    elif [[ -z $rest[1] ]]; then
      subs=(attach agents)
    elif [[ $rest[1] == -* ]]; then
      subs=(agents)
    else
      subs=(attach)
    fi
    local -a words  # shadow, not redundant: _main_complete can rerun this completer
    local CURRENT sub ret=1
    for sub in $subs; do
      words=("$orig[1]" "$sub" "${(@)rest}")
      CURRENT=$(( cur + 1 ))
      _claude && ret=0
    done
    return ret
  } && compdef _ca ca
fi

c() { cd "$@" && x } && compdef c=cd

datestamp() {
  # Args (day month year); omitted fields default to today. Pads to ISO YYYY-MM-DD
  # a <70 year maps to 20**, a <100 year maps to 19**
  local y=${3:-$(date +%Y)}
  printf '%04d-%02d-%02d\n' $(( y<70 ? y+2000 : y<100 ? y+1900 : y)) ${2:-$(date +%m)} ${1:-$(date +%d)}
}

