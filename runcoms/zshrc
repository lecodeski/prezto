(( $+commands[brew] )) && u() {
  local -i force=0
  (( $# > 1 )) && { print -u2 -r -- "$0: extra operand '$2'
Try '$0 --help' for more information." ; return 1 }
  case $1 in
    '') ;;
    -f|--force) force=1 ;;
    -h|--help) print -r -- \
'Usage: u [OPTION]

One-shot system updater: snapshot the installed brew state into the repo
Brewfile, update Prezto, upgrade brew bundle, formulae and casks, then restart
the shell once at the end. Every step is fatal - the first failure aborts.

Options:
  -f, --force  no Brewfile dump first, so the Brewfile pulled by the Prezto
               update wins over the installed package set, which otherwise
               wins by being snapshotted over it before the pull
  -h, --help   display this help and exit'
      return 0 ;;
    *) print -u2 -r -- "$0: unrecognized option '$1'
Try '$0 --help' for more information." ; return 1 ;;
  esac

  local brewfile=${ZPREZTODIR:-${ZDOTDIR:-$HOME}/.zprezto}/modules/homebrew/Brewfile
  [[ -s $brewfile ]] || {
    print -u2 "ERROR: Brewfile under $brewfile empty or missing - check Prezto working copy state. Aborting."
    return 1
  }
  ( # an inherited GIT_DIR outranks git -C; in subshell to not leak
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
    git -C ${brewfile:h} diff --quiet --diff-filter=U )
  (( $? == 1 )) && { # rc 1 is "unmerged paths found" — anything else is a git error, not a conflict
    print -u2 "💥 unresolved merge in the Prezto repo - resolve it (git status) before running u. Aborting."
    return 1
  }
  # always-block at end releases lock only if acquired here - the outer holder keeps it
  local -i parent_lock=$+_zprezto_update_lock_fd
  zprezto-update-trylock || return
  {
    (( force )) || HOMEBREW_NO_AUTO_UPDATE=1 brew bundle dump --force --file=$brewfile || {
      print -u2 "ERROR: could not dump current Brewfile"
      return 1
    }
    print -P '%B🍻 Updating Prezto:%b'
    zprezto-update --skip-restart || {
      print -u2 "💥 Could not update Prezto - check its working copy state and framework config. Aborting."
      return 1
    }
    print -P '\n%B🍻 Brew upgrades:%b'
    brew bundle cleanup --force --file=$brewfile && brew bundle install --no-upgrade --quiet --file=$brewfile && brew upgrade || {
      print -u2 "ERROR: could not upgrade Brew packages. Aborting."
      return 1
    }
    print -P '%BBrew upgrades finished 🍻%b\n'

    brew cu ${commands[mas]:+--include-mas} --no-brew-update --all --quiet --yes || {
      print -u2 "ERROR: could not upgrade Brew casks. Aborting."
      return 1
    }
    print -P '%BBrew cask upgrades finished 🍻%b\n'

    ferium upgrade

    zprezto-restart
  } always {
    (( ! parent_lock )) && zprezto-update-unlock
  }
} && alias uf='u --force'

# by Leah Neukirchen (http://leahneukirchen.org/dotfiles/.zshrc)
# wat - a better and recursive which/whence
# 2017-04-13 +leah+
# 2018-01-02 +leah+       print function code
# 2024-03-09 +lecodeski+  improve whatis and file output
# 2024-04-04 +lecodeski+  add whatis in function case
# 2025-07-28 +lecodeski+  add tldr in command case
# 2025-07-31 +lecodeski+  add another recursion after unalias
# 2026-05-06 +lecodeski+  massively improve wat function with type
# 2026-05-06 +lecodeski+  call brew which-formula for commands
# 2026-05-06 +lecodeski+  move whatis lookup below tldr
# 2026-06-01 +lecodeski+  avoid duplicate command lookups in wat function
# 2026-06-10 +lecodeski+  remove elif and separate condition check for function existence
# 2026-07-08 +lecodeski+  add: display file contents in `wat` function
wat() {
  ( # subshell to constrain unalias side-effects
  for cmd; do
    captioned-delimiter "wat is [$cmd]" '-'
    type -S "$cmd"
    if (( $+aliases[$cmd] )); then
      local -a words=(${${(z)aliases[$cmd]}:#(*=*|rlwrap|noglob|command)})
      unalias "$cmd"
      if [[ ${words[1]} == \"* ]]; then
        words[1]=${words[1]#\"}
        unalias "${words[1]}" 2>/dev/null
      fi
      if [[ ${words[1]} != "$cmd" ]]; then
        wat "${words[1]}"
        captioned-delimiter "looking up unaliased command [$cmd]" '-'
        wat "$cmd"
        continue
      fi
    fi

    if (( $+functions[$cmd] )); then
      whence -f "$cmd"
      (( $+commands[$cmd] )) && captioned-delimiter "shadowed command [$cmd]" '-'
    fi

    if (( $+commands[$cmd] )); then
      file "${commands[$cmd]}"
      if [[ "$(file -b --mime-encoding "${commands[$cmd]}")" != binary ]]; then
        bat "${commands[$cmd]}" --no-paging
      fi
      (( $+commands[tldr] )) && tldr "$cmd" --short-options
      whatis "$cmd" | grep "^${cmd}(" | sort --unique
      brew which-formula "$cmd"
    fi
  done
  )
