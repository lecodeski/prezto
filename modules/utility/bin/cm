#!/usr/bin/env bash
#
# ai-commit — generate a commit message for the staged diff and commit it.
# Portable bash (macOS, Linux, Windows/Git Bash).
# Fast path: one direct Haiku API call, authenticated via ANTHROPIC_API_KEY,
# the macOS Keychain item "anthropic-api-key", or the unexpired Claude Code
# OAuth token (macOS Keychain, or ~/.claude/.credentials.json on Linux/Windows).
# Fallback: `claude -p` with MCP servers stripped (uses Claude Code auth).
# Commit types: multi-valued `git config cm.type` ("name = meaning") — when set,
# the prompt lists them and a subject without "type(scope):" from that list is
# rejected.
# Pass -t/--time to print per-step timings (api call, fallback) to stderr.
#

set -u -o pipefail

model=claude-haiku-5-5
effort=low
me=${0##*/}

timing=0
if [[ ${1:-} == -t || ${1:-} == --time ]]; then
  timing=1
  shift
fi

# EPOCHREALTIME needs bash >= 5; fall back to whole seconds elsewhere
now() {
  if [[ -n ${EPOCHREALTIME:-} ]]; then printf '%s' "$EPOCHREALTIME"; else date +%s; fi
}
elapsed() { awk -v a="$1" -v b="$2" 'BEGIN { printf "%.2f", b - a }'; }

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "$me: not a repository work tree: $PWD" >&2
  exit 1
fi

diff=$(git diff --cached)
if [[ -z $diff ]]; then
  git add -A
  diff=$(git diff --cached)
  [[ -n $diff ]] && echo "$me: nothing staged, staged all changes" >&2
fi
if [[ -z $diff ]]; then
  echo "$me: nothing to commit" >&2
  exit 1
fi
diff=${diff:0:12000}

stat=$(git diff --cached --stat | tail -20)
style=$(git log -15 --format='%s' 2>/dev/null)
types=$(git config --get-all cm.type)
prefixes=$(sed 's/ *=.*//' <<<"$types" | paste -sd'|' -)
pick='pick it from what the diff does, never from how often it appears above'
scope='Follow the prefix with a scope in parentheses, then the colon, as in
  type(scope): — the scope is the module, directory, or file the diff touches,
  one short lowercase word. A breaking change may add ! before the colon:
  type(scope)!:'
if [[ -n $types ]]; then
  prefix_rule="- Start the subject with exactly one of these prefixes, no other —
  $pick:
$(sed 's/^/  /' <<<"$types")
- $scope"
# no cm.type: does any of the last 15 subjects carry a commit-type prefix?
#   ^[a-z]+         lowercase type at line start      feat, fix, chore, refac
#   (\([^)]*\))?    optional scope in parentheses     (api), (fzf)
#   !?              optional breaking-change marker   feat!:, feat(api)!:
#   :               colon right after                 → e.g. "Update README" no match
# one match is enough to switch prefix-plus-scope mode on
# <<< "here-string": feeds $style to grep's stdin, no echo pipe
elif grep -qE '^[a-z]+(\([^)]*\))?!?:' <<<"$style"; then
  prefix_rule="- Start the subject with a commit-type prefix from the set the recent
  subjects above use — $pick.
- $scope"
else
  prefix_rule='- Use no commit-type prefix — the recent subjects above use none.'
fi
# true when no cm.type is set, else the subject must open with "type(scope):"
# ${var%%pat}: cut the longest suffix that matches pat — %% from the first match on
#   ${1%%$'\n'*}        subject = first line of the message
#   ^($prefixes)        one configured type            e.g. add|mod|del|...
#   \([^\)]+\)          non-empty scope in parentheses (cm)
#   !?:                 optional breaking-change mark, then the colon
# "feat(x):", "mod:" without scope, "Fix(fzf):", "fix(cm)" without colon all fail
valid() {
  local subject=${1%%$'\n'*}
  [[ -z $prefixes || $subject =~ ^($prefixes)\([^\)]+\)!?: ]]
}
warn() { echo "💥 $me: $*" >&2; }
rejected() { echo "prefix outside cm.type (allowed: $prefixes): ${1%%$'\n'*}"; }

# Prompt tuned for Haiku: data first (query-at-end), rules grouped in XML tags,
# no literal backticks (double-quoted string -> would run command substitution).
# Keep the rules in sync with ~/.claude/commands/commit.md (/commit).
request="Write a git commit message for the staged changes shown below.

<recent_subjects>
$style
</recent_subjects>

<file_stats>
$stat
</file_stats>

<staged_diff_content>
$diff
</staged_diff_content>

Follow every rule below exactly.

<output>
Output only the raw commit message: no preamble, no explanation, no code
fences, and no 'subject:' or 'body:' labels.
</output>

<subject>
- Imperative mood, 50 characters max, no trailing period.
- Ends with exactly one emoji.
- Count the characters; if a draft exceeds 50, drop filler words before answering.
$prefix_rule
</subject>

<body>
Decide whether to write a body from the size and complexity of the staged diff:
- Trivial change (typo, rename, small tweak, or only a few lines) → subject only,
  NO body.
- Substantial change (new file, feature, or script; multiple concerns; changed
  behavior; or ~10+ changed lines) → write a body.
  - One blank line after the subject, then 1-6 sentences or bullets covering what
    changed, why, and notable design decisions visible in the diff.
  - Every body line is 72 characters max, with NO blank lines between them.
  - Start every sentence with an emoji; for bullets, use an emoji in place of the
    '-' marker.
</body>

<emojis>
- Never repeat an emoji anywhere in the message (subject and body combined).
- Do not limit your choice to the emojis seen in the recent subjects above.
</emojis>

<content>
- Be concrete: name the actual functions, files, or behavior that changed (e.g.
  'fix(greet): reject empty names', not 'fix(greet): improve validation').
- Wrap any code, command, filename, or identifier in backticks.
- Never present the commit as AI-authored: no AI or assistant attribution and no
  trailers. Describing AI functionality that the diff itself implements is fine.
</content>"

# python 3 for the direct API call; the version probe also weeds out
# broken installs and the Windows Store python stub
py=''
for cand in python3 python; do
  if command -v "$cand" >/dev/null 2>&1 \
      && "$cand" -c 'import sys; sys.exit(sys.version_info[0] < 3)' >/dev/null 2>&1; then
    py=$cand
    break
  fi
done

# Auth resolution: API key (env, then Keychain item "anthropic-api-key")
# > unexpired Claude Code OAuth token > claude -p. OAuth token lives in the
# Keychain on macOS, in ~/.claude/.credentials.json on Linux and Windows.
auth_mode='' secret='' new_key='' kc='' kc_locked=''
command -v security >/dev/null 2>&1 && kc=1
if [[ -n $py ]]; then
  secret=${ANTHROPIC_API_KEY:-$(security find-generic-password -s anthropic-api-key -w 2>/dev/null)}
  # security exit 44: item not found — any other failure: keychain locked or denied (e.g. over SSH)
  kc_rc=$?
  [[ -n $kc ]] && (( kc_rc != 0 && kc_rc != 44 )) && kc_locked=1
  if [[ -n $secret ]]; then
    auth_mode=apikey
  else
    creds=$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null)
    creds_file=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json
    [[ -z $creds && -r $creds_file ]] && creds=$(cat "$creds_file")
    if [[ -n $creds ]]; then
      secret=$(printf '%s' "$creds" | "$py" -c 'import json, sys, time
c = json.load(sys.stdin)["claudeAiOauth"]
e = c.get("expiresAt")
if e and e / 1000 <= time.time():
    sys.exit(1)
print(c["accessToken"])' 2>/dev/null | tr -d '\r')
      [[ -n $secret ]] && auth_mode=oauth
    fi
    if [[ -t 0 && -t 2 && -n $kc && -z $kc_locked ]]; then
      read -rsp "$me: no API key found. Paste one for $model (Enter skips): " new_key
      echo >&2
      [[ -n $new_key ]] && auth_mode=apikey secret=$new_key
    fi
  fi
fi

# OAuth token: raw API answers 429 for 5.x models; 4.5 rejects effort
api_model=$model api_effort=$effort
[[ $auth_mode == oauth ]] && api_model=claude-haiku-4-5 api_effort=''

[[ -n $kc_locked ]] && \
  warn "keychain not readable (security exit $kc_rc) — run 'security unlock-keychain' or set ANTHROPIC_API_KEY"
case $auth_mode in
  oauth) [[ -n $kc ]] && warn "no API key — falling back to $api_model via the Claude Code OAuth token" ;;
  '') [[ -n $py ]] && why='no API key and no valid OAuth token' || why='no python 3'
      warn "$why — falling back to claude -p" ;;
esac

msg='' t0=''
if [[ -n $auth_mode ]]; then
  (( timing )) && t0=$(now)
  msg=$(AIC_AUTH_MODE=$auth_mode AIC_SECRET=$secret AIC_MODEL=$api_model AIC_EFFORT=$api_effort \
    "$py" - "$request" "$me" <<'PY' | tr -d '\r'
import json, os, sys, urllib.request

headers = {"anthropic-version": "2023-06-01", "content-type": "application/json"}
if os.environ["AIC_AUTH_MODE"] == "oauth":
    headers["Authorization"] = "Bearer " + os.environ["AIC_SECRET"]
    headers["anthropic-beta"] = "oauth-2025-04-20"
else:
    headers["x-api-key"] = os.environ["AIC_SECRET"]

body = {
    "model": os.environ["AIC_MODEL"],
    "max_tokens": 4000,
    "messages": [{"role": "user", "content": sys.argv[1]}],
}
if os.environ["AIC_EFFORT"]:
    body["output_config"] = {"effort": os.environ["AIC_EFFORT"]}
req = urllib.request.Request(
    "https://api.anthropic.com/v1/messages",
    data=json.dumps(body).encode(),
    headers=headers,
)
def fall(cause, code):
    print(f"💥 {sys.argv[2]}: {cause} — falling back to claude -p", file=sys.stderr)
    sys.exit(code)

try:
    resp = json.load(urllib.request.urlopen(req, timeout=30))
except urllib.error.HTTPError as e:
    cause = ""
    try:
        cause = e.read().decode(errors="replace")
        cause = json.loads(cause)["error"]["message"]
    except Exception:
        pass
    fall(f"API call failed ({e}: {cause[:200]})", 1)
except Exception as e:
    fall(f"API call failed ({e})", 1)
try:
    stop = resp["stop_reason"]
    text = "".join(b["text"] for b in resp["content"] if b["type"] == "text").strip()
except Exception as e:
    fall(f"API reply malformed ({e!r})", 1)
# exit 3: an Anthropic reply proves the key, but it is unusable
if stop != "end_turn":
    fall(f"API call stopped ({stop})", 3)
if not text:
    fall("API reply had no text", 3)
print(text)
PY
)
  api_rc=$?
  [[ -n $msg ]] && state=ok || state=failed
  if [[ -n $msg ]] && ! valid "$msg"; then
    warn "$(rejected "$msg") — falling back to claude -p"
    msg='' state=rejected
  fi
  if [[ -n $new_key ]] && (( api_rc != 1 )); then
    printf 'add-generic-password -U -s anthropic-api-key -a %s -w %s\n' "$(id -un)" "$new_key" \
      | security -i >/dev/null
  fi
  (( timing )) && printf '%s: api call (%s, %s) %s: %ss\n' \
    "$me" "$api_model" "$auth_mode" "$state" "$(elapsed "$t0" "$(now)")" >&2
fi

if [[ -z $msg ]]; then
  (( timing )) && t0=$(now)
  # request via stdin: --mcp-config is variadic and would swallow a trailing arg
  # --setting-sources user: skip workspace settings — untrusted dirs warn otherwise
  msg=$(printf '%s\n' "$request" | claude -p --model "$model" --effort "$effort" --no-session-persistence \
    --setting-sources user --strict-mcp-config --mcp-config '{"mcpServers":{}}' | tr -d '\r') || {
    warn 'claude -p failed — aborting'
    exit 1
  }
  msg=${msg#"${msg%%[![:space:]]*}"}
  (( timing )) && printf '%s: claude -p fallback (%s): %ss\n' \
    "$me" "$model" "$(elapsed "$t0" "$(now)")" >&2
fi

if [[ -z $msg ]]; then
  warn 'empty message from model — aborting'
  exit 1
fi
if ! valid "$msg"; then
  warn "$(rejected "$msg") — aborting"
  exit 1
fi

git commit -qm "$msg" || exit 1
git -P log -1 --stat --summary --pretty=format:'%D [%h] %an%n%n%C(bold)%s%C(reset)%n%+b'
