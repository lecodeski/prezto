#!/usr/bin/env bash
#
# ai-commit — generate a commit message for the staged diff and commit it.
# Portable bash (macOS, Linux, Windows/Git Bash).
# Fast path: one direct API call (curl + jq), authenticated via ANTHROPIC_API_KEY,
# the macOS Keychain item "anthropic-api-key", the file
# ${XDG_CONFIG_HOME:-~/.config}/cm/anthropic-api-key (mode 600), or the
# unexpired Claude Code OAuth token (macOS Keychain, or
# ~/.claude/.credentials.json on Linux/Windows).
# Fallback: `claude -p` in safe mode without tools (uses Claude Code auth).
# Commit types: multi-valued `git config cm.type` ("name = meaning") — used in an
# own repo (no remote, or a remote of a `cm.remoteOwner`) or with
# `cm.prefix=true`; the prompt lists them and a subject without "type(scope):"
# from that list is rejected. `cm.prefix=false`: no prefix at all.
#

set -u -o pipefail

model=claude-sonnet-5-5
effort=medium
me=${0##*/}

# EPOCHREALTIME needs bash >= 5; fall back to whole seconds elsewhere
now() {
  if [[ -n ${EPOCHREALTIME:-} ]]; then printf '%s' "${EPOCHREALTIME/,/.}"; else date +%s; fi
}
elapsed() { awk -v a="$1" -v b="$2" 'BEGIN { printf "%.2f", b - a }'; }
warn() { echo "💥 $me: $*" >&2; }
die() { warn "$* — aborting"; exit 1; }
fall() { warn "$* — falling back to claude -p"; }
usage_error() { printf "%s: %s\nTry '%s --help' for more information.\n" "$me" "$1" "$me" >&2; exit 1; }

keep_msg() {
  local editmsg
  msg=${msg:-$draft}
  [[ -n $msg ]] || die "$1"
  editmsg=$(git rev-parse --git-path COMMIT_EDITMSG)
  printf '%s\n' "$msg" > "$editmsg" || die "$1"
  die "$1 (message kept, retry: git commit $2 $(printf '%q' "$editmsg"))"
}

is_own_repo() {
  local remotes
  remotes=$(git remote -v)
  # owner name between : (scp-style SSH) or / (HTTPS, ssh://) and the repo path — forges ignore its case
  [[ -z $remotes ]] || grep -qiF -f <(git config --get-all cm.remoteOwner | sed -n '/./{s|.*|:&/|p; s|^:|/|p;}') <<<"$remotes"
}

# prints why the subject is unusable — empty, or breaking cm.type — and succeeds;
# fails silently when it is fine: no cm.type set, or it opens with "type(scope):"
# ${var%%pat}: cut the longest suffix that matches pat — %% from the first match on
#   ${1%%$'\n'*}        subject = first line of the message
#   ^($prefixes)        one configured type            e.g. add|mod|del|...
#   \([^\)]+\)          non-empty scope in parentheses (cm)
#   !?:                 optional breaking-change mark, then the colon
#   \ .*[[:alnum:]]     a space, then a description with at least one letter or digit
# "dumb(ci): x" outside cm.type, "mod:" without scope, "Fix(fzf):", "fix(cm)" without colon,
# "fix(cm): 🐛" without description all break it
rejection() {
  local subject=${1%%$'\n'*}
  [[ -n $subject ]] || { echo 'empty subject from model'; return; }
  [[ -n $prefixes && ! $subject =~ ^($prefixes)\([^\)]+\)!?:\ .*[[:alnum:]] ]] &&
    echo "subject '$subject' does not match {type}({scope}): {emoji} {description}, {type} one of ${prefixes//|/, }"
}

timing=0
type_arg=''
for arg; do
  case $arg in
    -t|--time) timing=1 ;;
    -h|--help) cat <<EOF
Usage: $me [OPTION]... [TYPE]
Generate a commit message for the staged changes with Claude and commit them.
Stage all changes first when nothing is staged.

TYPE fixes the commit type, e.g. '$me feat' — any lowercase word, cm.type
names or not. It wins over cm.type and cm.prefix=false.

Options:
  -t, --time   print the time of each step to stderr
  -h, --help   display this help and exit

Git config:
  cm.type         "name = meaning", once per commit type
  cm.remoteOwner  user or organization name, e.g. lecodeski — repos with a
                  remote of that owner, and repos without a remote, use cm.type
  cm.prefix       true: always use cm.type, false: no type prefix
EOF
      exit 0 ;;
    -*) usage_error "unrecognized option '$arg'" ;;
    *) [[ -z $type_arg ]] || usage_error "extra operand '$arg'"
       [[ $arg =~ ^[a-z]+$ ]] || usage_error "invalid type '$arg' — lowercase letters only"
       type_arg=$arg ;;
  esac
done

git rev-parse --git-dir >/dev/null 2>&1 || die "not a repository work tree: $PWD"

diff=$(git diff --cached)
if [[ -z $diff ]]; then
  git add -A
  diff=$(git diff --cached)
  [[ -n $diff ]] && echo "$me: nothing staged, staged all changes" >&2
fi
[[ -n $diff ]] || die 'nothing to commit'
diff=${diff:0:12000}

stat=$(git diff --cached --stat | tail -20)
style=$(git log -15 --format='%s' 2>/dev/null)

prefix=$(git config --type=bool cm.prefix 2>/dev/null) || (( $? == 1 )) || die 'cm.prefix is not a boolean'
# --get-all alone merges all levels — a local cm.type must replace the house types
types=$(
  [[ $prefix == false ]] ||
    git config --local --get-all cm.type ||
    { [[ $prefix == true ]] || is_own_repo && git config --get-all cm.type; }
)
[[ $prefix == true && -z $types ]] && die 'cm.prefix=true but no cm.type set'
# type names joined by | — IFS cuts "name = meaning" at the first space or =, ${prefixes:+|} skips the first |
prefixes=''
while IFS=' =' read -r name _; do prefixes+=${prefixes:+|}$name; done <<<"$types"

choice_rule='Pick it from what the whole diff does, never from how often it appears above'
prefixed_format='- Format: {type}({scope}): {emoji} {description}
  A breaking change adds ! before the colon: {type}({scope})!: {emoji} {description}
- {scope}: the module, directory, or file the diff touches, one short lowercase word.'
plain_format='- Format: {description} {emoji}'

if [[ -n $type_arg ]]; then
  prefixes=$type_arg
  prefix_rule="$prefixed_format
- {type}: $type_arg — set by the user, no other."
elif [[ $prefix == false ]]; then
  prefix_rule=$plain_format
elif [[ -n $types ]]; then
  prefix_rule="$prefixed_format
- {type} MUST be exactly one of these prefixes — no other. $choice_rule:
  ${types//$'\n'/$'\n'  }"
# no cm.type: does any of the last 15 subjects carry a commit-type prefix?
#   ^[a-z]+         lowercase type at line start      feat, fix, chore, refac
#   (\([^)]*\))?    optional scope in parentheses     (api), (fzf)
#   !?              optional breaking-change marker   feat!:, feat(api)!:
#   :               colon right after                 → e.g. "Update README" no match
# one match is enough to switch prefix-plus-scope mode on
# <<< "here-string": feeds $style to grep's stdin, no echo pipe
elif grep -qE '^[a-z]+(\([^)]*\))?!?:' <<<"$style"; then
  prefix_rule="$prefixed_format
- {type} MUST be one prefix from the set the recent subjects above use. $choice_rule."
else
  prefix_rule=$plain_format
fi

# Prompt tuned for Haiku and Sonnet: data first (query-at-end), rules grouped in XML tags,
# no literal backticks (double-quoted string -> would run command substitution).
# Keep the rules in sync with ~/.claude/commands/commit.md (/commit).
request="Write a git commit message for the staged changes shown below.

<recent_subjects>
$style
</recent_subjects>

<file_stats>
$stat
</file_stats>

<staged_diff_content>
$diff
</staged_diff_content>

Follow every rule below exactly.

<subject>
$prefix_rule
- {emoji}: exactly one emoji, only there.
- {description}: imperative mood, no trailing period.
- The whole subject is 50 characters max. Count the characters; if a draft
  exceeds 50, drop filler words before answering.
</subject>

<body>
Decide whether to write a body from the size and complexity of the staged diff:
- Trivial change (typo, rename, small tweak, or only a few lines) → subject only,
  NO body.
- Substantial change (new file, feature, or script; multiple concerns; changed
  behavior; or ~10+ changed lines) → write a body.
  - One blank line after the subject, then 1-6 sentences or bullets covering what
    changed, why, and notable design decisions visible in the diff.
  - One sentence or bullet per line, with NO blank lines between them.
  - Start every sentence with an emoji; for bullets, use an emoji in place of the
    '-' marker.
</body>

<emojis>
- Never repeat an emoji anywhere in the message (subject and body combined).
- Do not limit your choice to the emojis seen in the recent subjects above.
</emojis>

<content>
- Be concrete: name the actual functions, files, or behavior that changed (e.g.
  'fix(greet): 🐛 reject empty names', not 'fix(greet): 🐛 improve validation').
- Wrap any code, command, filename, or identifier in backticks.
- Never present the commit as AI-authored: no AI or assistant attribution and no
  trailers. Describing AI functionality that the diff itself implements is fine.
</content>

<output>
Your reply becomes the commit message verbatim. Output only that message:
no preamble, no explanation, no code fences, no 'subject:' or 'body:'
labels, and no notes about the rules above — not whether a body was
written, not the subject length.
</output>"

has_api=''
command -v jq >/dev/null && command -v curl >/dev/null && has_api=1 || fall 'no jq or curl'

key_file=${XDG_CONFIG_HOME:-$HOME/.config}/cm/anthropic-api-key
has_security=''
command -v security >/dev/null && has_security=1

# API key: env, then Keychain item "anthropic-api-key", then key file — sets secret and kc_err
find_key() {
  secret=${ANTHROPIC_API_KEY:-}
  secret=${secret//[[:space:]]}
  if [[ -z $secret && -n $has_security ]]; then
    secret=$(security find-generic-password -s anthropic-api-key -w 2>/dev/null)
    local rc=$?
    # security exit 44: item not found, 36: keychain locked, 128: locked or access cancelled (e.g. over SSH)
    case $rc in
      0|44) ;;
      36|128) kc_err="keychain locked or access cancelled (security exit $rc) — run 'security unlock-keychain' or set ANTHROPIC_API_KEY" ;;
      *) kc_err="keychain lookup failed (security exit $rc)" ;;
    esac
  fi
  [[ -z $secret && -r $key_file ]] && read -r secret < "$key_file"
  secret=${secret//[[:space:]]}
}

store_key() {
  local tmp
  if [[ -n $has_security ]]; then
    printf 'add-generic-password -U -s anthropic-api-key -a %s -w %s\n' "$(id -un)" "$1" \
      | security -i >/dev/null
  else
    mkdir -p "${key_file%/*}" && tmp=$(mktemp "$key_file.XXXXXX") \
      && printf '%s\n' "$1" > "$tmp" && mv "$tmp" "$key_file"
  fi || warn 'could not store the API key — the next run asks again'
}

# Auth resolution: API key > unexpired Claude Code OAuth token > claude -p.
# OAuth token lives in the Keychain on macOS, in ~/.claude/.credentials.json
# on Linux and Windows.
auth_mode='' secret='' new_key='' kc_err=''
if [[ -n $has_api ]]; then
  find_key
  if [[ -n $secret ]]; then
    auth_mode=apikey
  else
    [[ -n $kc_err ]] && warn "$kc_err"

    creds=$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null)
    creds_file=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json
    [[ -z $creds && -r $creds_file ]] && creds=$(<"$creds_file")

    if [[ -n $creds ]]; then
      secret=$(jq -j '.claudeAiOauth | select(.expiresAt == null or .expiresAt / 1000 > now) | .accessToken // empty' \
        <<<"$creds" 2>/dev/null)
      [[ -n $secret ]] && auth_mode=oauth
    fi
    if [[ -t 0 && -t 2 && -z $kc_err ]]; then
      read -rsp "$me: no API key found. Paste one for $model (Enter skips): " new_key
      echo >&2
      new_key=${new_key//[[:space:]]}
      [[ -n $new_key ]] && auth_mode=apikey secret=$new_key
    fi
  fi
  [[ -n $auth_mode ]] || fall 'no API key and no valid OAuth token'
fi

# OAuth token: raw API answers 429 for 5.x models; 4.5 rejects effort
api_model=$model api_effort=$effort
if [[ $auth_mode == oauth ]]; then
  api_model=claude-haiku-4-5 api_effort=''
  warn "no usable API key — falling back to $api_model via the Claude Code OAuth token"
fi

msg='' draft='' t0=''
if [[ -n $auth_mode ]]; then
  (( timing )) && t0=$(now)
  auth="x-api-key: $secret"
  [[ $auth_mode == oauth ]] && auth="Authorization: Bearer $secret"$'\n''anthropic-beta: oauth-2025-04-20'

  # headers via a file descriptor: the secret stays out of argv and ps
  reply=$(printf '%s' "$request" |

    jq -Rc --arg model "$api_model" --arg effort "$api_effort" -s \
      '{$model, max_tokens: 16000, messages: [{role: "user", content: .}]}
      + if $effort == "" then {} else {output_config: {$effort}} end' |

    curl -q -sS --max-time 30 -w '\n%{http_code}' --data-binary @- \
      -H @<(printf '%s\n' 'anthropic-version: 2023-06-01' 'content-type: application/json' "$auth") \
      https://api.anthropic.com/v1/messages 2>&1)

  code=$? http=${reply##*$'\n'} reply=${reply%$'\n'*} state=failed

  if (( code )); then
    fall "API call failed (${reply%%$'\n'*})"
  elif [[ $http != 200 ]]; then
    fall "API call failed (HTTP $http: $(jq -ej '.error.message // empty' <<<"$reply" 2>/dev/null || printf '%s' "${reply:0:200}"))"
  elif ! stop=$(jq -ej '.stop_reason' <<<"$reply" 2>/dev/null); then
    fall 'API reply malformed'
  else
    # an Anthropic reply proves the key, usable or not
    [[ -n $new_key ]] && store_key "$secret"
    msg=$(jq -j '[.content[]? | select(.type == "text").text] | add // "" | gsub("^\\s+|\\s+$"; "")' <<<"$reply")
    # a native Windows jq writes LF as CRLF; -j adds no line end, so only the message needs this
    msg=${msg//$'\r'}
    if [[ $stop != end_turn ]]; then
      fall "API call stopped ($stop)"
      msg=''
    elif [[ -z $msg ]]; then
      fall 'API reply had no text'
    elif why=$(rejection "$msg"); then
      fall "$why"
      draft=$msg msg='' state=rejected
      request+=$'\n\n'"A previous draft was rejected: $why. Fix that."
    else
      state=ok
    fi
  fi

  (( timing )) && printf '%s: api call (%s, %s) %s: %ss\n' \
    "$me" "$api_model" "$auth_mode" "$state" "$(elapsed "$t0" "$(now)")" >&2
fi

if [[ -z $msg ]]; then
  (( timing )) && t0=$(now)
  # request via stdin: --tools is variadic and would swallow a trailing arg
  # --setting-sources user: skip workspace settings — untrusted dirs warn otherwise, --safe-mode included
  msg=$(printf '%s\n' "$request" | claude -p --model "$model" --effort "$effort" --no-session-persistence \
    --safe-mode --setting-sources user --tools "" | tr -d '\r')
  claude_rc=$?

  (( timing )) && printf '%s: claude -p fallback (%s): %ss\n' \
    "$me" "$model" "$(elapsed "$t0" "$(now)")" >&2
  (( claude_rc )) && { msg=$draft; keep_msg 'claude -p failed' '-e --cleanup=whitespace -F'; }

  # trim leading whitespace
  #   ${msg%%[![:space:]]*}   the whitespace run: cut from the first non-space char to the end
  #   ${msg#"…"}              cut that run off the front — quoted, so it matches literally
  msg=${msg#"${msg%%[![:space:]]*}"}

  why=$(rejection "$msg") && keep_msg "$why" '-e --cleanup=whitespace -F'
fi

# wrap the body only — a folded subject would spill into the body
#   *$'\n'*         the message has a body
#   ${msg%%$'\n'*}  subject: all before the first newline
#   ${msg#*$'\n'}   body: all after the first newline
#   ${body#$'\n'}   body without its blank first line — $'\n\n' puts exactly one back,
#                   git merges a non-blank line 2 into the subject
if [[ $msg == *$'\n'* ]]; then
  body=${msg#*$'\n'}
  msg=${msg%%$'\n'*}$'\n\n'$(fold -s -w 72 <<<"${body#$'\n'}")
fi

git commit -qm "$msg" || keep_msg 'git commit failed' -F
git -P log -1 --stat --summary --pretty=format:'%D [%h] %an%n%n%C(bold)%s%C(reset)%n%+b'
